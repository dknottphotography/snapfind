# Copy to .env and adjust. Nothing here costs money.
SECRET_KEY=change-me-to-something-random
JWT_SECRET=change-me-to-something-random-too

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# Cosine DISTANCE threshold for ArcFace matching (lower = stricter).
# DeepFace's default for ArcFace+cosine is 0.68. Start at 0.60.
FACE_MATCH_THRESHOLD=0.60

# Max upload size per request, in MB.
MAX_UPLOAD_MB=100

# ---- Couple's gallery (Cloudinary, unsigned upload preset) ----
# Create the preset in the CLIENT's Cloudinary account:
#   Settings -> Upload -> Add upload preset -> Signing mode: Unsigned
#   (allow image + video uploads; folder is optional — we send one anyway).
# Then set these two on the backend. Without them, gallery uploads are
# rejected with a clear error — photos are never silently stored locally,
# because local disk on a free host is wiped on restart.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
# Optional subfolder for gallery uploads inside the Cloudinary account.
CLOUDINARY_FOLDER=snapfind

# First admin (photographer) account — auto-created on startup.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin
ADMIN_PASSWORD=admin123
