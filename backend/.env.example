# Copy to .env and adjust. Nothing here costs money.
SECRET_KEY=change-me-to-something-random
JWT_SECRET=change-me-to-something-random-too

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# Cosine DISTANCE threshold for ArcFace matching (lower = stricter).
# DeepFace's default for ArcFace+cosine is 0.68. Start at 0.60.
FACE_MATCH_THRESHOLD=0.60

# Max upload size per request, in MB.
MAX_UPLOAD_MB=32

# First admin (photographer) account — auto-created on startup.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin
ADMIN_PASSWORD=admin123
